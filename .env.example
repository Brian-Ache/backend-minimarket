# =====================================================================
# backend-minimarket — variables de entorno
# =====================================================================
# La configuración se lee de variables de entorno, no de este archivo: el proyecto no incluye
# ninguna librería que cargue un `.env` solo. Para `./mvnw spring-boot:run` hay que exportarlo
# antes con `set -a; source .env; set +a`; `docker compose` sí lo lee del directorio.
#
# Esta es la lista completa de lo que la aplicación consulta. Cada variable muestra su valor
# por defecto, así que lo único que hay que completar de verdad son las dos obligatorias.
# =====================================================================

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
# Ojo con `localhost` cuando la app corre en un contenedor: ahí localhost es el contenedor
# mismo y no la base. Por eso `compose.yaml` arma la URL por su cuenta apuntando a `db`.
DB_URL="jdbc:mysql://localhost:3306/minimarket?allowPublicKeyRetrieval=true&useSSL=false&characterEncoding=UTF-8"
DB_USERNAME="root"
# OBLIGATORIA. Sin esto no hay conexión.
DB_PASSWORD=""

# Solo la usa `compose.yaml`: en qué puerto de la máquina publica el MySQL del contenedor.
# Cambiala si ya tenés un MySQL local ocupando el 3306.
DB_PORT_HOST="3306"

# ---------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------
# OBLIGATORIA: la app no arranca sin esto, a propósito. Al menos 32 bytes en base64.
# Generar con:  openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRATION_HOURS="24"

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
SERVER_PORT="8080"

# Zona horaria del proceso. No la lee la aplicación: la fija el contenedor. Sin esto corre en
# UTC y un punto de venta argentino fecharía cada venta, cada movimiento de caja y cada corte
# tres horas adelantados. Importa todavía más con el sync, donde la fecha ya es un dato del
# cliente y se valida contra el reloj del servidor.
TZ="America/Argentina/Buenos_Aires"

# Opciones de la JVM, a mano para ajustar memoria en el VPS sin rehacer la imagen.
JAVA_OPTS="-XX:MaxRAMPercentage=75"

# ---------------------------------------------------------------------
# JPA / Hibernate
# ---------------------------------------------------------------------
# `none` siempre: el esquema lo aplica `script/database/init.sql`, nunca Hibernate. `validate`
# sirve para comprobar que el esquema y las entidades no se hayan separado.
JPA_DDL_AUTO="none"
JPA_SHOW_SQL="false"

# ---------------------------------------------------------------------
# CORS y enlaces al front
# ---------------------------------------------------------------------
# Orígenes permitidos, separados por coma. En producción, el dominio real del front.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:1420"

# Base con la que se arman los enlaces que viajan dentro de los mails de invitación y de
# reseteo. Si apunta mal, el mail sale igual y el enlace no lleva a ninguna parte.
FRONTEND_URL="http://localhost:5173"

# ---------------------------------------------------------------------
# Mails (invitaciones y reseteo de contraseña)
# ---------------------------------------------------------------------
# Sin MAIL_HOST no hay bean JavaMailSender y la app no manda nada: deja el mail en el log con
# el enlace incluido, que es todo lo que hace falta para completar esos flujos en desarrollo.
# No hace falta un SMTP para trabajar.
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_SMTP_AUTH="true"
MAIL_SMTP_STARTTLS="true"
MAIL_TIMEOUT_MS="10000"
MAIL_FROM="no-reply@minimarket.local"
MAIL_FROM_NAME="Minimarket"

# ---------------------------------------------------------------------
# Reserva de stock de las ventas sin cobrar
# ---------------------------------------------------------------------
# Cuánto retiene una venta sin cobrar el stock que descontó al armarse. Pasado el plazo, un
# barrido la anula y devuelve la mercadería. En 0 el barrido queda apagado y las ventas sin
# cobrar viven indefinidamente.
VENTAS_RESERVA_MINUTOS="120"
VENTAS_RESERVA_REVISION_MS="300000"

# ---------------------------------------------------------------------
# Sincronización de tickets creados sin conexión
# ---------------------------------------------------------------------
# El tope del lote no es por tamaño del payload sino por cuánto tiempo el request retiene la
# base: cada evento es su propia transacción y toma locks de fila sobre stock y lotes. Cuando
# un lote lo supera, la respuesta dice el límite para que el front trocee sin adivinarlo.
SYNC_LOTE_MAXIMO="100"

# La fecha de un ticket offline la manda el dispositivo, así que se valida antes de guardarla:
# un reloj mal puesto envenena los reportes, el orden de los uuid v7 y la ventana de anulación.
SYNC_DESFASE_MAXIMO_MINUTOS="5"
SYNC_ANTIGUEDAD_MAXIMA_DIAS="60"
