# =====================================================================
# backend-minimarket — `.env` de PRODUCCIÓN (plantilla)
# =====================================================================
# Se copia como `.env` en el directorio del proyecto del VPS, al lado del compose de
# producción. **No se versiona**: el deploy no lo toca, vive en el servidor y nada más.
#
# Es distinto del `.env.example` de la raíz, que es el de desarrollo: acá no hay valores por
# defecto para lo que no puede quedar mal puesto. El compose falla al levantar y dice cuál
# falta, en vez de arrancar con algo razonable y equivocado.
#
#   chmod 600 .env    # tiene el secreto del JWT y las contraseñas de la base
# =====================================================================

# ---------------------------------------------------------------------
# Imagen
# ---------------------------------------------------------------------
# El repositorio de Docker Hub al que publica el workflow.
IMAGEN="tu-usuario/backend-minimarket"
# `latest` es lo que deja cada push a main. Para congelar una versión o hacer rollback, el
# tag exacto: IMAGEN_TAG="0.6.0", y después `docker compose up -d`.
IMAGEN_TAG="latest"

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
# La app entra con este usuario, que solo tiene permisos sobre `minimarket`. No uses root.
DB_USERNAME="minimarket"
DB_PASSWORD=""
# Solo para administrar la base; la aplicación no lo usa.
DB_ROOT_PASSWORD=""

# ---------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------
# Generar uno propio y distinto del de desarrollo:  openssl rand -base64 48
# Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRET=""
JWT_EXPIRATION_HOURS="24"

# ---------------------------------------------------------------------
# Dominios
# ---------------------------------------------------------------------
# El dominio real del front, separados por coma si hay más de uno. Mal puesto, el navegador
# bloquea cada request y parece un problema del backend.
CORS_ALLOWED_ORIGINS="https://minimarket.midominio.com"
# Base de los enlaces que viajan dentro de los mails de invitación y de reseteo.
FRONTEND_URL="https://minimarket.midominio.com"

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
TZ="America/Argentina/Buenos_Aires"
# Ajustar según la RAM del VPS.
JAVA_OPTS="-XX:MaxRAMPercentage=75"

# ---------------------------------------------------------------------
# SMTP
# ---------------------------------------------------------------------
# En producción sí hace falta: sin MAIL_HOST la app no manda nada y deja el mail en el log,
# así que las invitaciones y los reseteos de contraseña no llegan a destino.
#
# Valores listos para Gmail. Para activarlo alcanza con completar MAIL_USERNAME, MAIL_PASSWORD
# y MAIL_FROM, y `docker compose up -d`: no hay que volver a publicar la imagen.
#
# Tres cosas de Gmail que hacen perder una tarde si no se saben de antes:
#
#   1. MAIL_PASSWORD NO es la contraseña de la cuenta. Es una "contraseña de aplicación" de 16
#      caracteres, que Google solo deja generar con la verificación en dos pasos ya activada:
#      https://myaccount.google.com/apppasswords
#      Con la contraseña común, el SMTP responde 535 y el mail no sale.
#   2. MAIL_FROM tiene que ser la MISMA dirección de MAIL_USERNAME, o un alias verificado en
#      "Ver como" / "Send mail as" de Gmail. Cualquier otra, Gmail la reescribe en silencio por
#      la de la cuenta: el mail llega, pero desde una dirección que no elegiste.
#   3. La cuenta gratuita tiene un tope de unos 500 destinatarios por día. Para el volumen de
#      invitaciones y reseteos de un minimarket sobra; si un día no, el cambio es apuntar
#      MAIL_HOST a un SMTP transaccional y nada más.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
# La cuenta completa, con el @gmail.com.
MAIL_USERNAME=""
# La contraseña de aplicación de 16 caracteres. Google la muestra en grupos de a cuatro; los
# espacios se pueden dejar o sacar, va igual.
MAIL_PASSWORD=""
# Los dos de abajo son lo que pide Gmail en el 587 y no hay que tocarlos. Están acá para el día
# que el proveedor sea otro y pida otra cosa.
MAIL_SMTP_AUTH="true"
MAIL_SMTP_STARTTLS="true"
# En milisegundos, y aplica a conexión, lectura y escritura. Subirlo si el proveedor es lento:
# un timeout corto hace que la invitación falle sin que el usuario entienda por qué.
MAIL_TIMEOUT_MS="10000"
# Con Gmail, la misma dirección de MAIL_USERNAME (ver el punto 2 de arriba).
MAIL_FROM=""
MAIL_FROM_NAME="Minimarket"
