# Raíz del proyecto: no seguir buscando configuración hacia arriba.
config.stopBubbling = true

# Lombok copia estas anotaciones del campo al parámetro del constructor que genera.
# Sin esto, un @Lazy sobre un campo final es inerte: @RequiredArgsConstructor arma el
# constructor sin él y Spring resuelve la dependencia de forma temprana igual.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
